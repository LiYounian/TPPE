# TPPE 游戏服务（常驻）。由 deploy/install.sh 渲染后安装到 /etc/systemd/system/tppe.service，
# __USER__ / __DIR__ 会被替换成实际的运行用户和仓库路径；不要手工复制本文件。
[Unit]
Description=TPPE 多人填词造句游戏
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
Environment=TPPE_HOST=0.0.0.0
Environment=TPPE_PORT=__PORT__
Environment=TPPE_LOG_LEVEL=INFO
Environment=PYTHONUNBUFFERED=1
# 管理后台口令（TPPE_ADMIN_TOKEN=...），由 install.sh 生成，权限 600，不进仓库；文件不存在时后台关闭
EnvironmentFile=-/etc/tppe/admin.env
ExecStart=__DIR__/.venv/bin/python -m tppe
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
